{
  "entities": {
    "Listing": {
      "title": "Listing",
      "description": "Annuncio territoriale P2P o inserzione geolocalizzata in HAVE2WANT PLUS / Urbano3D.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["active", "pending", "completed", "suspended", "archived"] },
        "handshakeBuyerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "handshake_confirmed": { "type": "boolean" },
        "handshake_timestamp": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "title"]
    },
    "HandshakeProposal": {
      "title": "HandshakeProposal",
      "description": "Proposta e conferma Stretta di Mano P2P vincolata a owner e controparte autenticata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "proposerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "listingId", "proposerUid", "ownerUid", "status"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Attivita commerciale, bottega o professionista visibile come pin sulla mappa 3D Urbano3D.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 120 },
        "specialist_municipality_cap_verified": { "type": "boolean" },
        "piPaymentId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "name"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Portafoglio punti comunitari del Pioniere. I saldi monetari non sono modificabili arbitrariamente dal client SDK.",
      "type": "object",
      "properties": {
        "walletId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pointsBalance": { "type": "number" },
        "totalPointsEarned": { "type": "number" },
        "merchantPiBalance": { "type": "number" },
        "pioneerUsername": { "type": "string", "minLength": 1, "maxLength": 120 },
        "pioneerWalletAddress": { "type": "string", "maxLength": 128 },
        "adStreamEnabled": { "type": "boolean" },
        "adCompletedStreak": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["walletId", "pointsBalance", "totalPointsEarned", "pioneerUsername"]
    },
    "SalvavatuttoGuide": {
      "title": "SalvavatuttoGuide",
      "description": "Guida pratica di riparazione, autoproduzione o riuso pubblicata nell'Archivio Conoscenze & Mestieri.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "authorUid", "title", "content"]
    },
    "AbuseReport": {
      "title": "AbuseReport",
      "description": "Segnalazione etica o di abuso inviata da un utente autenticato verso un annuncio.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "reporterUid", "listingId", "reason"]
    },
    "PiIdempotencyRecord": {
      "title": "PiIdempotencyRecord",
      "description": "Chiave di idempotenza lato server per prevenire pagamenti duplicati e doppi prelievi A2U tra isolate.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 3, "maxLength": 160 },
        "kind": { "type": "string", "enum": ["payment_complete", "withdraw_idempotency", "payment_approve"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["key", "kind", "createdAt"]
    },
    "PiPaymentRecord": {
      "title": "PiPaymentRecord",
      "description": "Record di pagamento Pi Network (server-only, accesso negato a client). Traccia approvazione, completamento e metadati on-chain.",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "txid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "amountPi": { "type": "number" },
        "status": { "type": "string", "enum": ["approved", "completed", "cancelled", "failed"] },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "walletAddress": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "completedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["paymentId", "amountPi", "status", "uid"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat P2P tra due utenti (acquirente-venditore, carpool, ecc.). Accesso riservato ai due partecipanti.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participant1Uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participant2Uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "lastMessagePreview": { "type": "string", "maxLength": 200 },
        "unreadCount": { "type": "integer", "minimum": 0 },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": ["id", "participant1Uid", "participant2Uid", "createdAt", "lastMessageAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Messaggio in chat P2P (testo, nota vocale, sistema). Accesso solo ai partecipanti della chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "type": { "type": "string", "enum": ["text", "voice", "system"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "voiceNoteUrl": { "type": "string", "maxLength": 512 },
        "voiceDurationSec": { "type": "integer", "minimum": 1, "maximum": 300 }
      },
      "required": ["id", "chatId", "senderUid", "content", "type", "timestamp"]
    },
    "Call": {
      "title": "Call",
      "description": "Videochiamata WebRTC tra due utenti. Accesso riservato ai due partecipanti.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "callerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "calleeUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended", "rejected", "missed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "durationSec": { "type": "integer", "minimum": 0 },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": ["id", "callerUid", "calleeUid", "status", "createdAt"]
    },
    "SignalingMessage": {
      "title": "SignalingMessage",
      "description": "Messaggio di signaling WebRTC (offer, answer, ice-candidate). Accesso solo ai partecipanti della chiamata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "callId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["offer", "answer", "ice-candidate"] },
        "payload": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "callId", "senderUid", "type", "payload", "timestamp"]
    }
  },
  "firestore": {
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Annunci territoriali visibili pubblicamente in lettura; scrittura consentita solo a utenti autenticati proprietari e flusso Stretta di Mano vincolato."
    },
    "/listings/{listingId}/handshakes/{handshakeId}": {
      "schema": { "$ref": "#/entities/HandshakeProposal" },
      "description": "Proposte e conferme Stretta di Mano protette da Master Gate sul documento listing padre."
    },
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Negozi e attivita su mappa 3D visibili pubblicamente in lettura; scrittura consentita solo al titolare autenticato."
    },
    "/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Wallet privato del Pioniere autenticato: lettura e modifiche profilo limitate al proprietario, saldo punti protetto da scritture arbitrarie."
    },
    "/guides/{guideId}": {
      "schema": { "$ref": "#/entities/SalvavatuttoGuide" },
      "description": "Guide pratiche comunitarie dell'Archivio Conoscenze & Mestieri."
    },
    "/abuse_reports/{reportId}": {
      "schema": { "$ref": "#/entities/AbuseReport" },
      "description": "Segnalazioni di abuso create da utenti autenticati."
    },
    "/pi_idempotency/{keyHash}": {
      "schema": { "$ref": "#/entities/PiIdempotencyRecord" },
      "description": "Collezione esclusivamente server-side per lock atomici di idempotenza Pi Network."
    },
    "/pi_payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PiPaymentRecord" },
      "description": "Record pagamenti Pi Network (server-only). Traccia approvazione, completamento e metadati on-chain."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Chat P2P tra due utenti. Accesso riservato ai due partecipanti."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messaggi in chat P2P. Accesso solo ai partecipanti."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/Call" },
      "description": "Videochiamata WebRTC. Accesso riservato ai due partecipanti."
    },
    "/calls/{callId}/signaling/{signalId}": {
      "schema": { "$ref": "#/entities/SignalingMessage" },
      "description": "Messaggi signaling WebRTC (offer, answer, ice-candidate). Accesso solo ai partecipanti."
    }
  }
}
